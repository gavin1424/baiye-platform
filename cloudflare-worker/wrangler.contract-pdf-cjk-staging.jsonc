{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuang-baiye-contract-pdf-cjk-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "baiye-contract-pdf-cjk-staging",
      "database_id": "da16a375-7c57-4082-a407-94dd0417202c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTRACTS_BUCKET",
      "bucket_name": "baiye-contract-pdf-cjk-staging"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://baiye-platform-contract-signing-staging.pages.dev",
    "PUBLIC_SITE_URL": "https://baiye-platform-contract-signing-staging.pages.dev",
    "CONTRACT_SIGNING_MODE": "staging",
    "PARTNER_OTP_MODE": "staging",
    "SMS_OTP_MODE": "staging",
    "PLATFORM_WELCOME_COUPON_REDEMPTION_ENABLED": "0"
  }
}
