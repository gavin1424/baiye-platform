{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuang-baiye-soft-pos-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "baiye-soft-pos-staging",
      "database_id": "85566cab-a896-4ce1-a10f-4760b889fee9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://baiye-platform-soft-pos-staging.pages.dev",
    "PUBLIC_SITE_URL": "https://baiye-platform-soft-pos-staging.pages.dev",
    "CONTRACT_SIGNING_MODE": "staging",
    "PARTNER_OTP_MODE": "staging",
    "SMS_OTP_MODE": "staging",
    "PLATFORM_WELCOME_COUPON_REDEMPTION_ENABLED": "0"
  }
}
