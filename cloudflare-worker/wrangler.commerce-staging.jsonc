{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuang-baiye-commerce-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": {
    "APP_MODE": "staging",
    "ALLOWED_ORIGINS": "https://baiye-platform-commerce-staging.pages.dev,http://127.0.0.1:4173,http://localhost:4173",
    "AI_MODE": "disabled",
    "LINE_MODE": "disabled",
    "OTP_MODE": "disabled",
    "PAYMENT_PROVIDER_MODE": "disabled",
    "SHIPPING_PROVIDER_MODE": "disabled",
    "INVOICE_PROVIDER_MODE": "disabled",
    "EASYWALLET_API_MODE": "disabled",
    "UBER_DIRECT_MODE": "disabled",
    "SHOPEE_IMPORT_MODE": "disabled",
    "FINANCING_REFERRAL_MODE": "disabled",
    "EMAIL_MODE": "disabled",
    "SMS_MODE": "disabled",
    "PRODUCTION_READY": "0"
  },
  "d1_databases": [{
    "binding": "FINANCE_DB",
    "database_name": "baiye-commerce-staging",
    "database_id": "3e1f4da7-c8a2-44ec-959f-cfde52b51b59",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "COMMERCE_ASSETS",
    "bucket_name": "baiye-commerce-assets-staging"
  }]
}
