{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baiye-owner-admin-api",
  "main": "src/owner-worker.js",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "baiye-finance",
      "database_id": "1662c6ab-57d7-4df7-8056-935fbead2d8c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "OWNER_DOCUMENTS_BUCKET",
      "bucket_name": "baiye-owner-documents"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://admin.baiyeconnect.com,https://baiyeconnect.com,https://www.baiyeconnect.com"
  }
}
