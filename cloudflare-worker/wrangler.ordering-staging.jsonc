{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuang-baiye-ordering-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "baiye-ordering-staging",
      "database_id": "2e485adf-780a-424e-8299-5d2b25f307c9",
      "migrations_dir": "migrations-ordering-demo"
    }
  ],
  "vars": {
    "MEMBERSHIP_COUPON_ISSUANCE_ENABLED": "0",
    "DEMO_PASSWORD_LOGIN_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://baiye-platform-ordering-staging.pages.dev,https://baiye-beef-noodle-demo.pages.dev"
  }
}
