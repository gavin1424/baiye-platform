{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuang-baiye-ordering-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "FINANCE_DB",
      "database_name": "baiye-ordering-staging",
      "database_id": "2e485adf-780a-424e-8299-5d2b25f307c9",
      "migrations_dir": "migrations-ordering-staging"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://baiye-platform-ordering-staging.pages.dev,https://merchant-phone-password-v1.baiye-platform-ordering-staging.pages.dev,https://customer-qr-member-auth-v1.baiye-platform-ordering-staging.pages.dev",
    "APP_MODE": "staging",
    "PRODUCTION_DEMO_ENABLED": "true"
  }
}
