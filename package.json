{
  "name": "baiye-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:staging": "vite build && node scripts/prepare-staging-build.mjs",
    "build:beef-demo": "vite build && node scripts/prepare-beef-noodle-demo.mjs",
    "build:sites": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "payment:server": "node --env-file-if-exists=.env server/payment-api.mjs",
    "test:commerce": "node --test server/*.test.mjs",
    "test:contractor": "node --test cloudflare-worker/contractor-policy.test.mjs",
    "test:worker": "node --test cloudflare-worker/tests/*.test.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.18.2",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "pdfjs-dist": "^5.4.624",
    "typescript": "^7.0.2"
  }
}
