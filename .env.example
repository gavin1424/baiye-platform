# 百業商城付款 API（僅範例，不含任何真實憑證）
PAYMENT_MODE=mock
PAYMENT_PORT=8787
PAYMENT_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
PAYMENT_DATA_FILE=data/payment-runtime.local.json
PAYMENT_WEBHOOK_SECRET=

# 前端只設定 API 公開網址，不含任何金鑰。留空時使用瀏覽器本機測試付款。
VITE_PAYMENT_API_URL=

# 正式串接時由 TapPay Portal 取得，只能設定在伺服器環境變數。
TAPPAY_SERVER_TYPE=sandbox
TAPPAY_APP_ID=
TAPPAY_APP_KEY=
TAPPAY_PARTNER_KEY=
TAPPAY_MERCHANT_ID=
TAPPAY_APPLE_PAY_MERCHANT_ID=
TAPPAY_LINE_PAY_RETURN_URL=

# 雙重安全鎖：只有 PAYMENT_MODE=production 且此值為 true 才允許正式扣款。
ALLOW_LIVE_PAYMENTS=false
